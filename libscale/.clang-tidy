---
Checks: 'modernize-*,cppcoreguidelines-*,readability-*,bugprone-*,performance-*,concurrency-*,clang-analyzer-*,misc-*, -cppcoreguidelines-pro-type-vararg, -cppcoreguidelines-pro-bounds-pointer-arithmetic, -clang-diagnostic-builtin-macro-redefined, -clang-diagnostic-ignored-optimization-argument, -misc-multiple-inheritance, -misc-include-cleaner'
WarningsAsErrors: '*'
HeaderFilterRegex: 'src/.*|include/.*'
CheckOptions:
  - key:             readability-identifier-naming.ClassCase
    value:           CamelCase
  - key:             readability-identifier-naming.FunctionCase
    value:           lower_case
  - key:             readability-identifier-naming.VariableCase
    value:           lower_case
  - key:             readability-identifier-naming.NamespaceCase
    value:           lower_case
...
