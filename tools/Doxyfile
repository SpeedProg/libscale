# Doxygen Configuration File for strict documentation enforcement (Method 1)

PROJECT_NAME           = "Comfort Select Dashboard"
OUTPUT_DIRECTORY       = "build/docs"

# Input source locations (scans the entire public/internal header repository recursively)
INPUT                  = include/libscale include/gui
RECURSIVE              = YES

# Enforce explicit documentation (do not auto-document)
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES

# Warning Configuration
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = YES
WARN_FORMAT            = "$file:$line: $text"

# Interactive HTML site generation and quick-check XML
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES
HAVE_DOT               = NO

QUIET                  = YES
