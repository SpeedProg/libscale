# Doxygen configuration for libscale (strict documentation enforcement)

PROJECT_NAME           = "@PROJECT_NAME@"
OUTPUT_DIRECTORY       = "@PROJECT_BINARY_DIR@/docs"

# Input source locations (scans the public header repository recursively)
INPUT                  = "@PROJECT_SOURCE_DIR@/include/libscale"
RECURSIVE              = YES

# Enforce explicit documentation (do not auto-document)
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES

# Warning Configuration
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = YES
WARN_FORMAT            = "$file:$line: $text"

# Interactive HTML site generation and quick-check XML
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES
HAVE_DOT               = NO

QUIET                  = YES
